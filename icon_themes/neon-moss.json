{
  "$schema": "https://zed.dev/schema/icon_themes/v0.3.0.json",
  "name": "Neon Moss Icons",
  "author": "XOzymandiasz",
  "themes": [
    {
      "name": "Neon Moss Icons",
      "appearance": "dark",
      "directory_icons": {
        "collapsed": "./icons/folder.svg",
        "expanded": "./icons/folder-open.svg"
      },
      "file_stems": {
        "go.mod": "go-mod",
        "go.sum": "go-sum",
        "up.sql": "sql-up",
        "down.sql": "sql-down"
      },
      "file_suffixes": {
        "rs": "rust",
        "jsonc": "json",
        "json": "json",
        "go": "go",
        "sql": "sql",
        "up.sql": "sql-up",
        "down.sql": "sql-down"
      },
      "file_icons": {
        "go": {
          "path": "./icons/go.svg"
        },
        "rust": {
          "path": "./icons/rust.svg"
        },
        "json": {
          "path": "./icons/json.svg"
        },
        "default": {
          "path": "./icons/file.svg"
        },
        "go-mod": {
          "path": "./icons/go-mod.svg"
        },
        "go-sum": {
          "path": "./icons/go-sum.svg"
        },
        "sql": {
          "path": "./icons/sql.svg"
        },
        "sql-up": {
          "path": "./icons/sql-up.svg"
        },
        "sql-down": {
          "path": "./icons/sql-down.svg"
        }
      }
    }
  ]
}
