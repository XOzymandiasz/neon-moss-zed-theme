{
  "$schema": "https://zed.dev/schema/icon_themes/v0.3.0.json",
  "name": "Neon Moss Icons",
  "author": "XOzymandiasz",
  "themes": [
    {
      "name": "Neon Moss Icons",
      "appearance": "dark",
      "directory_icons": {
        "collapsed": "./icons/folder.svg",
        "expanded": "./icons/folder-open.svg"
      },
      "file_stems": {
        "go.mod": "go-mod",
        "go.sum": "go-sum",
        "up.sql": "sql-up",
        "down.sql": "sql-down",
        "readme": "readme",
        "readme.md": "readme",
        "readme.markdown": "readme",
        "readme.txt": "readme",
        "agents": "agents",
        "agents.md": "agents",
        ".gitignore": "gitignore",
        "README": "readme",
        "README.md": "readme",
        "README.markdown": "readme",
        "README.txt": "readme",
        "Readme": "readme",
        "Readme.md": "readme",
        "Readme.markdown": "readme",
        "Readme.txt": "readme",
        "AGENTS": "agents",
        "AGENTS.md": "agents",
        "Agents": "agents",
        "Agents.md": "agents",
        "Dockerfile": "docker",
        "DockerFile": "docker",
        "dockerfile": "docker",
        "DOCKERFILE": "docker",
        ".dockerignore": "dockerignore",
        ".dockerIgnore": "dockerignore",
        ".Dockerignore": "dockerignore",
        ".DockerIgnore": "dockerignore"
      },
      "file_suffixes": {
        "rs": "rust",
        "jsonc": "json",
        "json": "json",
        "go": "go",
        "sql": "sql",
        "up.sql": "sql-up",
        "down.sql": "sql-down",
        "md": "markdown",
        "markdown": "markdown",
        "mdown": "markdown",
        "dockerfile": "docker"
      },
      "file_icons": {
        "go": {
          "path": "./icons/go.svg"
        },
        "rust": {
          "path": "./icons/rust.svg"
        },
        "json": {
          "path": "./icons/json.svg"
        },
        "default": {
          "path": "./icons/file.svg"
        },
        "go-mod": {
          "path": "./icons/go-mod.svg"
        },
        "go-sum": {
          "path": "./icons/go-sum.svg"
        },
        "sql": {
          "path": "./icons/sql.svg"
        },
        "sql-up": {
          "path": "./icons/sql-up.svg"
        },
        "sql-down": {
          "path": "./icons/sql-down.svg"
        },
        "markdown": {
          "path": "./icons/markdown.svg"
        },
        "readme": {
          "path": "./icons/readme.svg"
        },
        "agents": {
          "path": "./icons/agents.svg"
        },
        "gitignore": {
          "path": "./icons/gitignore.svg"
        },
        "docker": {
          "path": "./icons/docker.svg"
        },
        "dockerignore": {
          "path": "./icons/dockerignore.svg"
        }
      },
      "named_directory_icons": {
        ".github": {
          "collapsed": "./icons/folder-github.svg",
          "expanded": "./icons/folder-github-open.svg"
        }
      }
    }
  ]
}
